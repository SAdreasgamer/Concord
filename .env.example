# Concord — Environment Variables
# Copy this file to .env and fill in your values.
# API keys are optional here — users can also provide them via the UI at runtime.

# Default LLM model (any litellm-supported model identifier)
# Examples: gemini/gemini-2.0-flash, gpt-4o, claude-sonnet-4-20250514
DEFAULT_LLM_MODEL=gemini/gemini-3.6-flash

# Server configuration
HOST=0.0.0.0
PORT=8000
